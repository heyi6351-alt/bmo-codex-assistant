# Vosk handles only the low-power wake phrase.
BMO_HARDWARE_PROFILE=orangepi-zero3-2gb
BMO_VOSK_MODEL=/opt/bmo/models/vosk-model-small-cn-0.22
BMO_WAKE_PHRASES=BMO,哔某,比莫,你好BMO,Hey BMO

# whisper.cpp handles the full command with automatic Chinese/English detection.
BMO_WHISPER_BIN=whisper-cli
BMO_WHISPER_MODEL=/opt/bmo/models/ggml-base.bin

# sounddevice accepts a unique substring. Confirm it on the board with:
# python -m bmo_voice --list-audio-devices
BMO_AUDIO_DEVICE=ReSpeaker
BMO_SAMPLE_RATE=16000
BMO_BLOCK_SIZE=4000
BMO_ENERGY_THRESHOLD=350
BMO_SPEECH_START_TIMEOUT=5.0
BMO_SILENCE_TIMEOUT=1.1
BMO_MAX_UTTERANCE_SECONDS=30
BMO_FOLLOWUP_TIMEOUT=8
BMO_MAX_CONVERSATION_TURNS=6
BMO_WAKE_POLL_SECONDS=1

# ReSpeaker Lite hardware AEC makes playback-time interruption practical.
# Tune the threshold after running a real enclosure test.
BMO_BARGE_IN_ENABLED=1
BMO_BARGE_IN_ENERGY_THRESHOLD=650
BMO_BARGE_IN_CHUNKS=2

# Reasoning brain for spoken turns.
#   codex  (default) — Codex CLI handles every turn.
#   openai           — an OpenAI-compatible chat endpoint answers ordinary
#                      questions and proactive briefings, so casual Q&A does not
#                      consume Codex quota. Coding jobs and Lark actions still
#                      use Codex (below).
BMO_BRAIN=codex
# Required when BMO_BRAIN=openai. base_url is the OpenAI-compatible root that
# has /chat/completions under it — include the version segment, e.g. .../v1.
# The API key is read from the environment; keep it out of source and logs.
BMO_OPENAI_BASE_URL=
BMO_OPENAI_MODEL=
BMO_OPENAI_API_KEY=
BMO_OPENAI_TIMEOUT_SECONDS=60

# Codex is the brain. Keep its normal user config so installed Lark skills and
# authentication remain available. Projects must live below this root.
# The workspace is Codex's working directory and must be writable at runtime;
# it lives under /var/lib/bmo because the service mounts /opt read-only
# (ProtectSystem=strict). The installer seeds it with AGENTS.md.
BMO_CODEX_BIN=codex
BMO_CODEX_WORKSPACE=/var/lib/bmo/codex_workspace
BMO_CODEX_PROJECT_ROOT=/var/lib/bmo/projects
BMO_CODEX_SESSION_FILE=/var/lib/bmo/codex-session.json
BMO_CODEX_JOBS_FILE=/var/lib/bmo/codex-jobs.json
BMO_CODEX_JOB_HISTORY=50
BMO_CODEX_TIMEOUT_SECONDS=300
BMO_CONFIRMATION_TIMEOUT_SECONDS=120
# If your ChatGPT-plan Codex quota is exhausted, point Codex itself at your
# OpenAI-compatible endpoint so coding/actions also stop using that quota:
# define a model provider in ~/.codex/config.toml (base_url + env_key) as the
# bmo user, then set the profile/model here. Requires a model with tool/function
# calling. Leave empty to use Codex's default account/model.
BMO_CODEX_PROFILE=
BMO_CODEX_MODEL=

# GitHub delivery is always confirmation-gated. Authenticate `gh` separately as
# the dedicated bmo user. BMO only pushes bmo/<job-id> branches and creates PRs.
BMO_GIT_BIN=git
BMO_GH_BIN=gh
BMO_GIT_AUTHOR_NAME=BMO
BMO_GIT_AUTHOR_EMAIL=bmo@localhost
BMO_PUBLISH_TIMEOUT_SECONDS=120

# Lark office layer. Authenticate this same Linux user with:
# lark-cli auth login --domain calendar,task,im
BMO_LARK_CLI_BIN=lark-cli
BMO_TIMEZONE=Asia/Shanghai
BMO_AGENDA_POLL_SECONDS=60
BMO_MEETING_REMINDER_MINUTES=5

# Presence adapter: a sensor sidecar writes `present` or `absent` to this file.
BMO_PRESENCE_FILE=/run/bmo/presence
BMO_PRESENCE_ABSENT_SECONDS=300
BMO_PRESENCE_COOLDOWN_SECONDS=3600

# Do-not-disturb: any sidecar can write `1`, `true`, or `dnd` to this file to
# silence proactive reminders until it is cleared.
BMO_DND_FILE=/run/bmo/dnd

# Night-time quiet window. Reminders and daily planning are suppressed inside
# this range; handles overnight ranges like 22:30-08:00.
BMO_QUIET_HOURS_START=22:30
BMO_QUIET_HOURS_END=08:00

# Morning DDL planner. Default is draft-only. Enable writes only after accepting
# the standing policy described in README; writes are limited to personal
# attendee-free events prefixed [BMO专注].
BMO_DAILY_PLAN_TIME=09:10
BMO_AUTOPLAN_WRITES=0

# Empty means arrival briefings do not search messages. If enabled, keep this a
# narrow, allowlisted project/keyword query; message content is untrusted data.
BMO_WORK_MESSAGE_QUERY=

# Optional custom TTS. {text} is replaced without invoking a shell. If empty,
# macOS `say` or Linux `espeak-ng` is selected with a zh/en voice.
BMO_TTS_COMMAND=

# The Orange Pi web face reads BMO_VOICE_STATE_FILE directly. Leave the legacy
# Armada bridge empty unless an Armada daemon is also running.
BMO_BODY_URL=
BMO_VOICE_STATE_FILE=/var/lib/bmo/voice-state.json
