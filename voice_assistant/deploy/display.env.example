# The purchased 4.3-inch HDMI controller advertises 800x480 through EDID.
# xsession.sh requests this mode when xrandr exposes it and otherwise keeps the
# display's preferred mode.
BMO_DISPLAY_MODE=800x480

# Where the local BMO face server listens. Defaults match the code and the
# kiosk/self-check, so leave these commented unless you must move the port.
# bmo-display.service reads this file; xsession.sh opens the same port.
#BMO_DISPLAY_HOST=127.0.0.1
#BMO_DISPLAY_PORT=8765
#BMO_DISPLAY_ROOT=/opt/bmo/voice_assistant/web
