[Unit]
Description=BMO local HDMI face server
After=local-fs.target

[Service]
Type=simple
User=bmo
Group=bmo
WorkingDirectory=/opt/bmo/voice_assistant
Environment=HOME=/home/bmo
Environment=BMO_VOICE_STATE_FILE=/var/lib/bmo/voice-state.json
ExecStart=/opt/bmo/voice_assistant/.venv/bin/python -m bmo_voice.display
Restart=always
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/bmo/voice_assistant
ReadWritePaths=/var/lib/bmo

[Install]
WantedBy=multi-user.target
